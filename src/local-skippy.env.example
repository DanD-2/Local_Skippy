# Copy to /etc/local-skippy/local-skippy.env and keep permissions at 600.

# Host identity and policy
LOCAL_SKIPPY_HOST_LABEL=Skippy
LOCAL_SKIPPY_TARGET_OS=ubuntu-26.04
LOCAL_SKIPPY_AI_LOAD_POLICY=balanced

# GPU policy: finance first, then shared capacity for other agents.
LOCAL_SKIPPY_FINANCE_GPU_DEVICES=0
LOCAL_SKIPPY_SHARED_GPU_DEVICES=1,2
# Optional explicit GPU order override. If unset, finance devices are prepended automatically.
# LOCAL_SKIPPY_GPU_PRIORITY_ORDER=0,1,2

# CPU controls: enforce with both systemd (Ollama) and container limits (Open WebUI).
LOCAL_SKIPPY_OLLAMA_CPU_QUOTA=75%
LOCAL_SKIPPY_WEBUI_CPU_LIMIT=2.0
LOCAL_SKIPPY_WEBUI_MEMORY_LIMIT=8g

# Core runtime endpoints
LOCAL_SKIPPY_OLLAMA_HOST=127.0.0.1:11434
LOCAL_SKIPPY_OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_SKIPPY_WEBUI_URL=http://127.0.0.1:3000
LOCAL_SKIPPY_WEBUI_PORT=3000
LOCAL_SKIPPY_WEBUI_CONTAINER_PORT=8080
LOCAL_SKIPPY_WEBUI_CONTAINER_NAME=open-webui
LOCAL_SKIPPY_WEBUI_VOLUME=open-webui
LOCAL_SKIPPY_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Optional OpenAI-compatible provider file (root-owned, chmod 600)
LOCAL_SKIPPY_CLOUD_ENV_FILE=/etc/local-skippy/cloud-provider.env

# Agent defaults
LOCAL_SKIPPY_FINANCE_ALWAYS_ON=1
LOCAL_SKIPPY_FINANCE_RESTART_POLICY=always
LOCAL_SKIPPY_WEEKLY_REPORT_DAY=Sun
LOCAL_SKIPPY_WEEKLY_REPORT_TIME=04:00
