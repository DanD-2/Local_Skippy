# Copy to /etc/default/local-llm and adjust for the target host.
# Set permissions: sudo chmod 600 /etc/default/local-llm

# ── GPU Configuration ────────────────────────────────────────────────────────
# All three GPUs are allocated to AI inference on a dedicated server.
# Confirm actual device numbering with: nvidia-smi -L
LOCAL_LLM_EXPECTED_GPUS=3
LOCAL_LLM_GPU_DEVICES=0,1,2

# ── Ollama ───────────────────────────────────────────────────────────────────
LOCAL_LLM_OLLAMA_HOST=127.0.0.1:11434
LOCAL_LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Open WebUI ───────────────────────────────────────────────────────────────
LOCAL_LLM_WEBUI_PORT=3000
LOCAL_LLM_WEBUI_CONTAINER_PORT=8080
LOCAL_LLM_WEBUI_CONTAINER_NAME=open-webui
LOCAL_LLM_WEBUI_VOLUME=open-webui
LOCAL_LLM_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
LOCAL_LLM_WEBUI_URL=http://127.0.0.1:3000

# ── Cloud AI Provider Keys (optional) ────────────────────────────────────────
# Add API keys here if cloud AI fallback is enabled for any agent.
# NEVER commit actual keys to the repository.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Infrastructure Agent — Proxmox (optional) ────────────────────────────────
# Restricted API token for the Infrastructure agent Proxmox access.
# See docs/proxmox-integration.md for token setup.
# NEVER commit actual secrets to the repository.
# PROXMOX_HOST=https://192.168.128.X:8006
# PROXMOX_TOKEN_ID=infra-agent@pve!skippy
# PROXMOX_TOKEN_SECRET=