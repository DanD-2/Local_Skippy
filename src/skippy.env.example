# Copy to /etc/default/skippy and fill in values.
# Permissions: sudo chmod 640 /etc/default/skippy && sudo chown root:ollama /etc/default/skippy

# ── Host identity ──────────────────────────────────────────────────────────────
SKIPPY_HOSTNAME=skippy.aybara.local
SKIPPY_LAN_IP=192.168.128.5

# ── GPU configuration ─────────────────────────────────────────────────────────
# All three RTX 4060 GPUs are dedicated to AI inference.
# Format: comma-separated CUDA device indices.
LOCAL_LLM_EXPECTED_GPUS=3
LOCAL_LLM_GPU_DEVICES=0,1,2

# ── CPU overflow policy ───────────────────────────────────────────────────────
# CPUQuota for the ollama.service systemd unit.
# Target: ≤ 75 % of total CPU cores for AI overflow.
# Set to: (number_of_cores × 100) × 0.75
# Example: 16-core CPU → 1200% (16 × 100 × 0.75 = 1200)
# Run: nproc --all  to find the core count.
SKIPPY_OLLAMA_CPU_QUOTA=1200%

# ── Ollama service settings ───────────────────────────────────────────────────
LOCAL_LLM_OLLAMA_HOST=127.0.0.1:11434
LOCAL_LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Keep models loaded indefinitely (Finance agent always-resident policy).
# Set to a duration like "5m" for on-demand agents if you prefer auto-eviction.
OLLAMA_KEEP_ALIVE=-1

# ── Open WebUI container settings ────────────────────────────────────────────
LOCAL_LLM_WEBUI_PORT=3000
LOCAL_LLM_WEBUI_CONTAINER_PORT=8080
LOCAL_LLM_WEBUI_CONTAINER_NAME=open-webui
LOCAL_LLM_WEBUI_VOLUME=open-webui
LOCAL_LLM_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
LOCAL_LLM_WEBUI_URL=http://127.0.0.1:3000

# ── Evaluation logging ────────────────────────────────────────────────────────
SKIPPY_LOG_DIR=/var/log/skippy

# ── Proxmox integration (Infrastructure agent) ───────────────────────────────
# Fill in real values — NEVER commit real credentials to the repository.
SKIPPY_PROXMOX_HOST=https://<proxmox-host-ip>:8006
SKIPPY_PROXMOX_TOKEN_ID=<proxmox-user>@pve!<token-id>
SKIPPY_PROXMOX_TOKEN_SECRET=<proxmox-token-secret>

# ── Online AI provider API keys (all optional) ────────────────────────────────
# NEVER commit real API keys to the repository.
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>
