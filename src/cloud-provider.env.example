# Copy to /etc/local-skippy/cloud-provider.env and keep permissions at 600.
# Keep LOCAL-first behavior; only enable cloud when required.

ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace_me

# Optional provider metadata for reports
LOCAL_SKIPPY_CLOUD_PROVIDER_NAME=openai-compatible
LOCAL_SKIPPY_CLOUD_DEFAULT_MODEL=gpt-5.2
